{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@ghostmail/database": ["./packages/database/src/index.ts"],
      "@ghostmail/database/*": ["./packages/database/src/*"]
    }
  }
}
